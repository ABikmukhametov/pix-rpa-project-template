                <_value xmlns:d9p1="http://www.w3.org/2001/XMLSchema" i:type="d9p1:string">if (!string.IsNullOrEmpty(clones_root))
{
    project_root = System.IO.Path.Combine(clones_root, System.Environment.UserName);

    if (!System.IO.Directory.Exists(project_root))
    {
        throw new System.Exception(
            "Клон не настроен: нет каталога " + project_root
        );
    }
}
