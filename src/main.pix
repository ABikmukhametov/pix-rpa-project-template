                <_expression i:nil="true" />
                <_screenShotBase64 i:nil="true" />
                <_value xmlns:d9p1="http://www.w3.org/2001/XMLSchema" i:type="d9p1:string">string config_full_path = System.IO.Path.Combine(
    project_root, "data", "configs", "config.json"
);

string json = System.IO.File.ReadAllText(config_full_path);

json = System.Text.RegularExpressions.Regex.Replace(
    json,
    "\"max_batch_size\"\\s*:\\s*\\d+",
    "\"max_batch_size\": " + max_batch_size_from_master
);

json = System.Text.RegularExpressions.Regex.Replace(
    json,
    "\"max_serial_errors\"\\s*:\\s*\\d+",
    "\"max_serial_errors\": " + max_serial_errors_from_master
);

json = System.Text.RegularExpressions.Regex.Replace(
    json,
    "\"max_deal_attempts\"\\s*:\\s*\\d+",
    "\"max_deal_attempts\": " + max_deal_attempts_from_master
);

System.IO.File.WriteAllText(config_full_path, json);</_value>
                <_xpathSettings xmlns:d9p1="http://schemas.datacontract.org/2004/07/BR.XPath" i:nil="true" />
